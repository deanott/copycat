// inter_agent_wishlist.jsonl — an executable-SHAPED spec of multi-agent scenarios.
// NOT run by run.py (it only reads scenarios.jsonl). Same row shape as scenarios.jsonl PLUS:
//   "status": "works" | "gap" | "aspirational"
//   "expect": [tool,...]  -> for status==works: the real tool(s) that satisfy it today
//   "wants":  "tool_name" -> for gap/aspirational: the HYPOTHETICAL tool the ideal flow needs
// Parse by skipping lines beginning with //. Everything else is strict JSONL.
{"id": "w-handoff-read-current", "user": "Agent A copied a value; I'm agent B — read the current shared clipboard and use it.", "status": "works", "expect": ["clipboard_read_current"], "why": "Shared daemon means B reads exactly what A wrote. Basic hand-off works today."}
{"id": "w-handoff-history", "user": "What did agent A copy earlier so I can continue its work?", "status": "works", "expect": ["clipboard_history"], "why": "Time-ordered history already lets a later agent recover an earlier agent's copies."}
{"id": "w-handoff-secret-mask", "user": "Agent A staged an API key; list the recent clipboard and it must stay masked.", "status": "works", "expect": ["clipboard_history"], "why": "Sensitivity classifier + masked previews already protect secrets across a hand-off."}
{"id": "w-pin-survive-handoff", "user": "Pin the token the setup agent staged so it survives until the deploy agent reads it.", "status": "works", "expect": ["clipboard_pin", "clipboard_history"], "why": "Pinning already exempts an entry from eviction across a multi-step hand-off."}
{"id": "w-private-daemon", "user": "Give this Claude Code session its own private clipboard, isolated from my other session.", "status": "works", "expect": ["clipboard_status"], "why": "COPYCAT_SOCK already runs an isolated per-session daemon; status confirms which one you're on."}
{"id": "w-wait-for-value", "user": "Block until agent A produces the build-artifact URL, then hand it back to me.", "status": "gap", "wants": "clipboard_wait", "why": "No blocking read exists; B must poll clipboard_read_current. A daemon-side long-poll (wait until a new/matching entry) closes this."}
{"id": "w-wait-typed", "user": "Wait for the next JSON payload to appear on the clipboard, then give it to me.", "status": "gap", "wants": "clipboard_wait", "why": "Blocking read filtered by ContentKind (Json). ContentKind already exists on Entry; needs a wait tool + predicate."}
{"id": "w-take-once", "user": "Claim the staged one-time token so no other agent can also consume it.", "status": "gap", "wants": "clipboard_take", "why": "Consume-once / claim semantics. Store currently has no notion of a claimed-and-removed entry; needs an atomic take."}
{"id": "w-channel-post", "user": "Post this review summary to the 'reviewer' channel, not the general clipboard.", "status": "gap", "wants": "clipboard_copy{channel}", "why": "No addressing/channel field. Add an optional channel (mailbox) key to Copy + the store's index."}
{"id": "w-channel-read", "user": "Read the next item posted to the 'deploy' channel.", "status": "gap", "wants": "clipboard_read{channel}", "why": "Requires the same channel field on Read/Recall to scope retrieval to a mailbox."}
{"id": "w-agent-identity", "user": "Show me which agent copied each of the recent entries.", "status": "gap", "wants": "clipboard_history{agent}", "why": "Source.device is free text and the only 'who' signal; promote it to a first-class, trusted agent id surfaced in listings."}
{"id": "w-agent-filter", "user": "Show only what the 'planner' agent copied, ignore everything else.", "status": "gap", "wants": "clipboard_history{agent}", "why": "Recall has no filter by source/agent. Add an agent predicate to the Recall query."}
{"id": "w-namespace-isolation", "user": "Copy this into my namespace so other agents on this daemon can't see it.", "status": "gap", "wants": "clipboard_copy{namespace}", "why": "Within one daemon there is no in-process isolation; only whole-daemon separation via COPYCAT_SOCK. Needs namespaced entries + ACLs."}
{"id": "w-isolation-secret", "user": "Agent B must NOT be able to read a secret that agent C staged in a different channel.", "status": "gap", "wants": "clipboard_read{channel}", "why": "Isolation requires scoped channels/namespaces with access control; today everything on one daemon is shared."}
{"id": "w-ack-consumed", "user": "Tell me once the downstream agent has actually consumed the value I staged.", "status": "gap", "wants": "clipboard_take", "why": "Needs consume-once plus a readable claim/ack state so the producer learns the item was taken."}
{"id": "w-cross-runtime", "user": "Cursor staged a diff; my Claude Code agent in another process should pick it up.", "status": "aspirational", "wants": "clipboard_read_current", "why": "Works locally IF both point at the same daemon socket; a robust cross-runtime contract (discovery, auth, agent identity across runtimes) is the larger bet."}
{"id": "w-cross-machine", "user": "An agent on my laptop stages a value; an agent on the CI box retrieves it.", "status": "aspirational", "wants": "clipboard_sync", "why": "Requires the cloud relay / cross-device sync. Wire protocol is already relay-friendly; transport + e2e crypto is unbuilt."}
{"id": "w-subscribe", "user": "Stream every new clipboard entry to my agent as it arrives.", "status": "aspirational", "wants": "clipboard_subscribe", "why": "Push/notify instead of poll. Needs a subscription channel over the socket and MCP notifications."}
{"id": "w-mailbox-direct", "user": "Send this specifically to agent 'deployer-7' and to no one else.", "status": "aspirational", "wants": "clipboard_send{to}", "why": "Direct per-agent addressed delivery (a true mailbox), on top of trusted agent identity."}
{"id": "w-provenance-verify", "user": "Only accept the staged value if it genuinely came from the trusted planner agent.", "status": "aspirational", "wants": "clipboard_read{verify}", "why": "Requires signed provenance on entries, not just a free-text device label; ties into agent identity + crypto."}
{"id": "w-fanout-consume", "user": "Broadcast this config to all downstream agents, and let each of them read it exactly once.", "status": "aspirational", "wants": "clipboard_take{channel}", "why": "Channel fan-out with per-consumer consume-once cursors — a small message-bus, not a clipboard, in spirit."}
